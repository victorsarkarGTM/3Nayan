{
  "name": "3nayan",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "format": "prettier --write .",
    "db:start": "pnpm --filter @3nayan/db db:start",
    "db:stop": "pnpm --filter @3nayan/db db:stop",
    "db:reset": "pnpm --filter @3nayan/db db:reset",
    "db:test": "pnpm --filter @3nayan/db db:test",
    "db:types": "pnpm --filter @3nayan/db db:types"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild"
    ]
  }
}
